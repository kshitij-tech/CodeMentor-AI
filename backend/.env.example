APP_ENV=development

# Database
DATABASE_URL=sqlite:///./codementor.db

# Authentication
JWT_SECRET_KEY=replace-this-with-a-random-secret-at-least-32-bytes-long

# AI provider
# Primary development provider: local Ollama (no API key required).
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
AI_MODEL=qwen3:8b

# Optional cloud fallback. Leave disabled for fully local operation.
AI_FALLBACK_PROVIDER=none
AI_FALLBACK_MODEL=
MISTRAL_API_KEY=

# Code execution sandbox
# Development may use the local runner. Production must use Docker.
EXECUTION_SANDBOX=local
EXECUTION_DOCKER_IMAGE=codementor-multi-runtime:latest
