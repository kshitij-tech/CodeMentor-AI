APP_ENV=development

# Database
DATABASE_URL=sqlite:///./codementor.db

# Authentication
# Generate a unique secret for each deployment. Production requires >= 32 bytes.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Browser origins allowed to call the API. Use a comma-separated list.
# Never use "*" or "null" with credentialed requests.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5500,http://127.0.0.1:5500

# AI provider
# Local options: ollama or lmstudio.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_MODEL=qwen2.5-coder:3b

# LM Studio alternative:
# AI_PROVIDER=lmstudio
# LMSTUDIO_BASE_URL=http://localhost:1234
# AI_MODEL=mistralai/ministral-3-3b

# Optional cloud fallback. Leave disabled for fully local operation.
AI_FALLBACK_PROVIDER=none
AI_FALLBACK_MODEL=
MISTRAL_API_KEY=

# Code execution sandbox
# Development may use the local runner. Production must use Docker.
EXECUTION_SANDBOX=local
EXECUTION_DOCKER_IMAGE=codementor-multi-runtime:latest
