# Copy to .env on the production host; never commit the real file.
POSTGRES_DB=codementor
POSTGRES_USER=codementor
CORS_ORIGINS=https://codementor.example.com
APP_VERSION=0.2.0
APP_HTTP_PORT=8080
WEB_CONCURRENCY=2
DOCKER_GID=999
EXECUTION_IMAGE=codementor-multi-runtime:prod
BACKEND_IMAGE=codementor-backend:prod
FRONTEND_IMAGE=codementor-frontend:prod
AI_PROVIDER=mistral
AI_MODEL=mistral-small-latest
AI_FALLBACK_PROVIDER=none
AI_FALLBACK_MODEL=
